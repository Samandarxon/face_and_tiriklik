# ============================================================================
#  Golang Face Backend — Docker'siz (systemd) rejim
#  O'rnatiladigan joy: /etc/face/face-backend.env   (chmod 600 — sirlar bor!)
#
#  DIQQAT: systemd EnvironmentFile qator ichidagi izohni TUSHUNMAYDI.
#  Izoh faqat alohida qatorda.
# ============================================================================

# --- Tarmoq -----------------------------------------------------------------
# Bu servis kirdi_chiqdi backendiga ochiladi. Ikkalasi bitta serverda bo'lsa
# 127.0.0.1 qoldiring. Alohida serverlarda bo'lsa nginx + TLS orqali oching,
# to'g'ridan-to'g'ri 0.0.0.0 ga chiqarmang.
PORT=8080
GIN_MODE=release
READ_TIMEOUT=30s
WRITE_TIMEOUT=60s

# --- Python AI servis (gRPC) ------------------------------------------------
AI_SERVICE_TARGET=127.0.0.1:50051
AI_TIMEOUT=30s

# --- Qdrant -----------------------------------------------------------------
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=faces
VECTOR_SIZE=512
QDRANT_TIMEOUT=15s
# Qdrant'da auth yoqilgan bo'lsa (qdrant.env dagi QDRANT__SERVICE__API_KEY),
# xuddi shu qiymatni shu yerga yozing. Aks holda bo'sh qoldiring.
QDRANT_API_KEY=

# --- Kalitlar bazasi (PostgreSQL) -------------------------------------------
# Yuz vektorlari Qdrant'da. Bu baza faqat mijoz, API kalit va audit uchun.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=face
POSTGRES_PASSWORD=CHANGE-ME
POSTGRES_DB=face_auth
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_CONNECT_TIMEOUT=10s

# --- Tanish chegarasi -------------------------------------------------------
# 0.50 = juda yumshoq | 0.65 = muvozanatli | 0.75+ = qat'iy
MATCH_THRESHOLD=0.65
# 1:1 tasdiqlash (`/persons/{id}/verify`) uchun ALOHIDA chegara.
#
# Nima uchun 1:N dan yumshoqroq: u yerda nomzod butun baza, ya'ni chegara
# pasaysa har bir begona yozuv tasodifan mos kelish imkoniga ega bo'ladi.
# 1:1 da nomzod bitta va u chaqiruvchi tomonidan hujjatdan olingan —
# begona bilan chalkashish xavfi umuman yo'q. Bu yerda qattiq chegara
# faqat haqiqiy odamni rad etadi (masalan arxiv fotosi bir necha yillik
# bo'lgani uchun).
# Sozlanmagan bo'lsa MATCH_THRESHOLD dan 0.10 past olinadi — ya'ni 1:1 HAR
# DOIM 1:N dan yumshoqroq bo'ladi, MATCH_THRESHOLD qanday qo'yilganidan
# qat'i nazar. Aniq son yozsangiz, u shu munosabatni bekor qiladi.
#CONFIRM_THRESHOLD=

MAX_UPLOAD_BYTES=10485760

# --- person_id = PNFL --------------------------------------------------------
#
# Yuz servisi `subject_id` (PNFL) ni normallashtirib AYNAN o'zini `person_id`
# qilib saqlaydi. Maxfiy kalit (pepper) yo'q va kerak ham emas — shuning uchun
# bu servisni boshqa serverga ko'chirish uchun hech qanday sirni birga olib
# yurish shart emas.
#
# true (standart) — faqat 14 xonali PNFL qabul qilinadi.
# false — tabel raqami kabi boshqa formatlarga ham ruxsat.
SUBJECT_ID_STRICT_PNFL=true

# --- MAJBURIY SIR ------------------------------------------------------------
#
# ADMIN_BOOTSTRAP_KEY — kamida 32 belgi. Faqat bazada birorta ham faol kalit
# bo'lmaganda ishlaydi. Birinchi kalitni olgach BU QATORNI BO'SHATING va
# servisni qayta ishga tushiring.
ADMIN_BOOTSTRAP_KEY=

# --- Xavfsizlik va kuzatuv --------------------------------------------------
# PRODUCTION: aniq domen, masalan https://app.example.uz
CORS_ALLOW_ORIGIN=*
AUTH_CACHE_TTL=30s
# Kalitda o'z chegarasi ko'rsatilmaganda. 0 = cheklovsiz.
DEFAULT_RATE_LIMIT_PER_MIN=600
AUDIT_QUEUE_SIZE=2048
METRICS_ENABLED=true
SWAGGER_ENABLED=true
