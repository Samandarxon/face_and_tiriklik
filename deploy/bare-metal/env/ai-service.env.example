# ============================================================================
#  Python AI Service — Docker'siz (systemd) rejim
#  O'rnatiladigan joy: /etc/face/ai-service.env
#
#  DIQQAT: systemd EnvironmentFile qator ichidagi izohni TUSHUNMAYDI.
#      DET_SIZE=640   # izoh   <-- XATO
#  Izoh faqat alohida qatorda.
# ============================================================================

# --- Tarmoq -----------------------------------------------------------------
# HTTP (Swagger /docs, /health) — faqat lokal.
AI_HOST=127.0.0.1
AI_PORT=8000

# gRPC — Golang face-backend AYNAN shu orqali ulanadi. Faqat lokal.
GRPC_ENABLED=true
GRPC_HOST=127.0.0.1
GRPC_PORT=50051

LOG_LEVEL=INFO

# --- Qurilma ----------------------------------------------------------------
# auto = CUDA bo'lsa GPU, aks holda CPU. Boshqa qiymatlar: cpu | cuda
DEVICE=auto
GPU_ID=0

# --- InsightFace ------------------------------------------------------------
INSIGHTFACE_MODEL=buffalo_l
# Modellar shu papkaga yuklab olinadi (~300 MB). install.sh oldindan yuklaydi.
INSIGHTFACE_ROOT=/opt/face/models/insightface

# DET_SIZE — detektsiya kirish o'lchami; oqimdagi eng katta tor joy.
# 640 = eng aniq (standart) | 320 = kiosk/webcam uchun sezilarli tezroq
DET_SIZE=640
DET_SCORE_THRESHOLD=0.60

# --- Yuz sifati filtri ------------------------------------------------------
MIN_FACE_SIZE=80
MIN_BLUR_SCORE=45
MAX_IMAGE_SIDE=1920
MAX_UPLOAD_BYTES=10485760

# --- Anti-Spoofing (Liveness) -----------------------------------------------
LIVENESS_ENABLED=true
# Vaznlar shu papkada. install.sh download_models.sh ni chaqirib to'ldiradi.
LIVENESS_MODEL_DIR=/opt/face/app/python-ai-service/resources/anti_spoof_models
# 0.65 = yumshoq | 0.75 = tavsiya | 0.85 = qat'iy
LIVENESS_THRESHOLD=0.75
LIVENESS_REQUIRE_UNANIMOUS=true
# PRODUCTION'da albatta true: model yuklanmasa so'rov rad etiladi.
LIVENESS_FAIL_CLOSED=true

EMBEDDING_DIM=512
