# ============================================================================
#  Qdrant — Docker'siz (systemd) rejim uchun sozlamalar
#  O'rnatiladigan joy: /etc/face/qdrant.env
#
#  DIQQAT: systemd EnvironmentFile qatorning OXIRIGACHA hammasini qiymat deb
#  oladi. Shu sababli bu yerda QATOR ICHIDA izoh yozib bo'lmaydi:
#      PORT=6333   # izoh   <-- XATO, qiymat "6333   # izoh" bo'lib qoladi
#  Izoh faqat alohida qatorda, `#` bilan boshlanadi.
# ============================================================================

# Faqat lokal tarmoqda tinglaydi — face-backend ham shu serverda turadi.
# Qdrant'ni boshqa serverdan ochish kerak bo'lsa 0.0.0.0 qiling VA
# QDRANT__SERVICE__API_KEY ni albatta to'ldiring.
QDRANT__SERVICE__HOST=127.0.0.1
QDRANT__SERVICE__HTTP_PORT=6333
QDRANT__SERVICE__GRPC_PORT=6334

QDRANT__STORAGE__STORAGE_PATH=/var/lib/qdrant/storage
QDRANT__STORAGE__SNAPSHOTS_PATH=/var/lib/qdrant/snapshots

QDRANT__LOG_LEVEL=INFO

# --- Autentifikatsiya (ixtiyoriy) -------------------------------------------
# BO'SH QIYMAT BILAN QOLDIRMANG. `QDRANT__SERVICE__API_KEY=` (kalitsiz) yozsangiz
# Qdrant auth'ni yoqadi, lekin hech qanday kalit mos kelmaydi va har qanday
# so'rov 401 bo'ladi. Kerak bo'lmasa — butunlay izohda qoldiring.
# Yoqsangiz, face-backend.env dagi QDRANT_API_KEY ga xuddi shu qiymatni qo'ying.
# QDRANT__SERVICE__API_KEY=bu-yerga-uzun-tasodifiy-kalit
