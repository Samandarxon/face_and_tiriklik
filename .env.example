# ============================================================================
#  Face Auth Microservice — sozlamalar
#  Nusxa oling:  cp .env.example .env
# ============================================================================

# --- Portlar ---
BACKEND_PORT=8080
AI_PORT=8000          # Python HTTP (Swagger /docs, debug)
AI_GRPC_PORT=50051    # Python gRPC — Golang backend shu orqali ulanadi
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334

# --- Qurilma: auto (CUDA bo'lsa GPU) | cpu | cuda ---
DEVICE=auto
GPU_ID=0
LOG_LEVEL=INFO
GIN_MODE=release

# --- Anti-Spoofing (Liveness) ---------------------------------------------
LIVENESS_ENABLED=true
# "Tirik" deb hisoblash uchun minimal ehtimol. Yuqori => xavfsizroq, lekin
# haqiqiy odamlar ham ko'proq rad etiladi.
#   0.65 = yumshoq | 0.75 = tavsiya etiladi | 0.85 = qat'iy (yuqori xavfsizlik)
LIVENESS_THRESHOLD=0.75
# true => ansambldagi HAR IKKALA model "real" deyishi shart (FAR pasayadi)
LIVENESS_REQUIRE_UNANIMOUS=true
# true => model yuklanmasa so'rov rad etiladi (fail-closed). PRODUCTION'da true!
LIVENESS_FAIL_CLOSED=true

# --- Yuz sifati filtri -----------------------------------------------------
# --- REAL-TIME TEZLIGI ---------------------------------------------------
# DET_SIZE — yuz detektsiyasining kirish o'lchami. Oqimdagi ENG KATTA tor joy
# aynan shu (anti-spoofing modeli 80x80 da ishlaydi va deyarli bepul).
# 640 -> 320 ga tushirilsa detektsiya sezilarli tezlashadi va ramka ravonroq
# harakatlanadi.
#   640 = eng aniq (uzoq/kichik yuzlarni ham topadi) — standart
#   320 = kiosk/webcam uchun tavsiya (yuz yaqin bo'lganda aniqlik yetarli)
# Diqqat: bu register/verify aniqligiga ham ta'sir qiladi.
DET_SIZE=640
DET_SCORE_THRESHOLD=0.60
MIN_FACE_SIZE=80          # piksel; kichik yuzda anti-spoofing ishonchsiz
MIN_BLUR_SCORE=45         # Laplasian dispersiyasi; past => xira kadr rad etiladi
MAX_CONCURRENT_INFERENCE=4

# --- Qidiruv ---------------------------------------------------------------
# Cosine similarity chegarasi. buffalo_l uchun amaliy oraliq:
#   0.50 = juda yumshoq | 0.65 = muvozanatli | 0.75+ = qat'iy
MATCH_THRESHOLD=0.65
# 1:N da 1-o'rin 2-o'rindan kamida shuncha oldinda bo'lmasa natija noaniq deb
# rad etiladi (yaqin o'xshash ikki odam). 0 — o'chiq. Haqiqiy FAR/FRR o'lchanib
# sozlanishi kerak.
MATCH_MARGIN=0.05
# 1:1 tasdiqlash (`/persons/{id}/verify`) uchun ALOHIDA chegara.
#
# Nima uchun 1:N dan yumshoqroq: u yerda nomzod butun baza, ya'ni chegara
# pasaysa har bir begona yozuv tasodifan mos kelish imkoniga ega bo'ladi.
# 1:1 da nomzod bitta va u chaqiruvchi tomonidan hujjatdan olingan —
# begona bilan chalkashish xavfi umuman yo'q. Bu yerda qattiq chegara
# faqat haqiqiy odamni rad etadi (masalan arxiv fotosi bir necha yillik
# bo'lgani uchun).
# Sozlanmagan bo'lsa MATCH_THRESHOLD dan 0.10 past olinadi — ya'ni 1:1 HAR
# DOIM 1:N dan yumshoqroq bo'ladi, MATCH_THRESHOLD qanday qo'yilganidan
# qat'i nazar. Aniq son yozsangiz, u shu munosabatni bekor qiladi.
#CONFIRM_THRESHOLD=

QDRANT_COLLECTION=faces
MAX_UPLOAD_BYTES=10485760

# --- Qdrant autentifikatsiyasi ------------------------------------------------
# Standart holatda O'CHIRIQ (quyidagi qator izohda turibdi) — lokal ishlash uchun.
#
# ⚠️  BU QATORNI BO'SH QIYMAT BILAN QOLDIRMANG!
#     `QDRANT__SERVICE__API_KEY=` (kalitsiz) yozsangiz, Qdrant auth'ni yoqadi,
#     lekin hech qanday kalit mos kelmaydi va HAR QANDAY so'rov 401 bo'ladi.
#     Kerak bo'lmasa — butunlay izohda qoldiring yoki o'chirib tashlang.
#
# Yoqish uchun izohni oching va o'z kalitingizni qo'ying (backend ham shu
# qiymatni avtomatik oladi):
# QDRANT__SERVICE__API_KEY=<openssl rand -base64 48 natijasi>

# --- Xavfsizlik ------------------------------------------------------------
#
# CORS faqat BRAUZERGA tegishli. Bu servisga odatda boshqa backend murojaat
# qiladi (X-API-Key bilan, server-server) — bunday so'rovda Origin umuman
# bo'lmaydi va bu sozlama unga hech qanday ta'sir qilmaydi.
#
# Ya'ni brauzerni butunlay yopish hech qanday integratsiyani buzmaydi va
# PRODUCTION uchun to'g'ri tanlov aynan shu:
#
#   none                     — hech qanday brauzer (production)
#   https://app.example.com  — bitta aniq origin (front to'g'ridan-to'g'ri
#                              shu servisga murojaat qilsagina)
#   https://a.uz,https://b.uz — bir nechta, vergul bilan
#   *                        — har qanday sahifa (FAQAT ishlab chiqishda)
#
# ⚠️  Bo'sh qoldirilsa `*` deb qabul qilinadi — bu ataylab: "unutib
#     qoldirilgan" sozlama jimgina hammani yopib qo'ymasligi kerak. Yopish
#     uchun aniq `none` yozing.
#
# Eslatma: yuz oqimiga (WebSocket) Origin'siz ulanuvchi mijozlar — ya'ni
# boshqa backend'ning proxysi — `none` da ham o'tadi. Ular baribir bir
# martalik ticket bilan tekshiriladi. Brauzer esa Origin'ni har doim
# yuboradi, shuning uchun bu chekinish orqali sahifa o'tolmaydi.
CORS_ALLOW_ORIGIN=none

# ============================================================================
#  KIRISH NAZORATI — servis YOPIQ, har bir so'rov API kalit talab qiladi
# ============================================================================

# --- Kalitlar bazasi (yuz vektorlaridan ALOHIDA) ----------------------------
# Bu Postgres faqat mijozlar, API kalitlar va so'rovlar jurnali uchun.
# Yuz vektorlari Qdrant'da qoladi.
FACE_POSTGRES_USER=face
FACE_POSTGRES_PASSWORD=***REMOVED***
FACE_POSTGRES_DB=face_auth

# --- person_id: PNFL ning O'ZI -----------------------------------------------
#
# Servis `subject_id` (PNFL) ni normallashtiradi va AYNAN o'zini `person_id`
# qilib saqlaydi. Hech qanday maxfiy kalit, hash yoki pepper ishlatilmaydi.
#
# Buning ma'nosi: baza o'z-o'zini tushuntiradi va KO'CHMA bo'ladi. Rasm kiradi,
# PNFL chiqadi. Servisni boshqa serverga ko'chirish, zaxiradan tiklash yoki
# boshqa tizimga ulash uchun hech qanday sirni birga olib yurish shart emas.
#
# ⚠️  Evaziga: vektor bazasi endi shaxsiy ma'lumot saqlaydi ("shu yuz — shu
#     PNFL"). Shuning uchun himoya INFRATUZILMADA bo'lishi shart:
#       - Qdrant tashqi tarmoqqa chiqarilmaydi va QDRANT__SERVICE__API_KEY qo'yiladi
#       - disk shifrlanadi (LUKS/dm-crypt yoki bulut disk shifri)
#       - har bir so'rov API kalit bilan keladi va auditga tushadi
#
# ESKI O'RNATMALAR: .env da FACE_ID_PEPPER qolib ketgan bo'lsa u shunchaki
# e'tiborsiz qoldiriladi. Mavjud (hash bilan yozilgan) yozuvlarni PNFL ga
# o'tkazish uchun: DOCKERSIZ_ISHGA_TUSHIRISH.md dagi migratsiya bo'limi.

# subject_id faqat 14 xonali PNFL bo'lishi shartmi.
# true (standart) — aralash formatlar bazaga tushmaydi.
# false — tabel raqami kabi boshqa identifikatorlarga ham ruxsat.
SUBJECT_ID_STRICT_PNFL=true

# --- Birinchi kalitni olish uchun -------------------------------------------
# Kamida 32 belgi. FAQAT bazada birorta ham faol kalit bo'lmaganda ishlaydi —
# birinchi kalit berilishi bilan avtomatik yopiladi.
# Kalitni olgach bu qatorni bo'shating va `make up` ni qayta bajaring.
ADMIN_BOOTSTRAP_KEY=

# --- Cheklovlar va kuzatuv --------------------------------------------------
# Tekshirilgan kalit shuncha vaqt keshda turadi (bazaga har so'rovda bormaslik
# uchun). Bekor qilish va rotatsiya keshdan darhol chiqaradi.
AUTH_CACHE_TTL=30s
# Kalitda o'z chegarasi ko'rsatilmaganda. 0 = cheklovsiz.
DEFAULT_RATE_LIMIT_PER_MIN=600
# /metrics (Prometheus) va /swagger/index.html
METRICS_ENABLED=true
SWAGGER_ENABLED=true

# --- Aktiv liveness (server buyruq beradi) -----------------------------------
#
# Passiv anti-spoofing (MiniFASNet) bosma suratni va ekrandagi tasvirni to'sadi.
# Lekin u OLDINDAN YOZILGAN VIDEONI to'sa olmaydi — video haqiqiy odamning
# haqiqiy yuzidan olingan, ya'ni har qanday tekstura testidan o'tadi.
#
# Aktiv tekshiruv shu bo'shliqni yopadi: server har ulanishda TASODIFIY buyruq
# beradi ("chapga buriling"), foydalanuvchi bajaradi, va faqat shundan keyin
# tanish bosqichiga o'tiladi. Yozib qo'yilgan videoda buyruq oldindan ma'lum
# emas, shuning uchun mos javob bo'lishi mumkin emas.
#
# Kuchi uchta shartga tayanadi va bittasi tushib qolsa qolgani ham ma'nosiz:
#   1. buyruq tasodifiy   (crypto/rand, math/rand EMAS)
#   2. buyruq bir martalik (muvaffaqiyatli seans qayta o'ynatilmaydi)
#   3. javob 5 soniyada    (hujumchi video tayyorlashga ulgurmasin)
#
# ⚠️  NIMANI TO'SMAYDI: real vaqtdagi deepfake buyruqqa javob bera oladi.
#     Aktiv tekshiruv passiv modelning O'RNINI BOSMAYDI, uni to'ldiradi.
#
# Standart YOQIQ. Yuz orqali LOGIN shu oqimga bog'langan (VMS backend
# oqim bergan grantsiz kirishni rad etadi), ya'ni bu tekshiruv akkauntga
# kirishni himoya qiladi. U foydalanuvchidan bir harakat talab qiladi va
# kiosk oqimini bir-ikki soniyaga sekinlashtiradi — o'chirish mumkin, lekin
# bu ATAYLAB qabul qilinadigan qaror bo'lsin.
ACTIVE_LIVENESS_ENABLED=true

# --- gRPC TLS (face-backend <-> ai-service), ixtiyoriy -----------------------
#
# Bo'sh qoldirilsa kanal ochiq (TLS'siz) — faqat yopiq docker tarmog'ida
# qabul qilinadi. Kadrlar va yuz vektorlari shu kanaldan o'tadi, shuning uchun
# xostlar alohida bo'lsa yoki tarmoq umumiy bo'lsa, yoqing.
#
# ai-service (server):
#   GRPC_TLS_CERT_FILE      — server sertifikati (PEM)
#   GRPC_TLS_KEY_FILE       — server kaliti (PEM)
#   GRPC_TLS_CLIENT_CA_FILE — berilsa mTLS: faqat shu CA imzolagan mijoz ulanadi
# face-backend (mijoz):
#   AI_GRPC_TLS_CA_FILE     — ai-service sertifikatini tekshiruvchi CA
#   AI_GRPC_TLS_CERT_FILE   — mTLS uchun mijoz sertifikati
#   AI_GRPC_TLS_KEY_FILE    — mTLS uchun mijoz kaliti
#   AI_GRPC_TLS_SERVER_NAME — sertifikat SAN'idagi nom (masalan ai-service)
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CLIENT_CA_FILE=
AI_GRPC_TLS_CA_FILE=
AI_GRPC_TLS_CERT_FILE=
AI_GRPC_TLS_KEY_FILE=
AI_GRPC_TLS_SERVER_NAME=
